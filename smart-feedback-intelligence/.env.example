# ── API ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production

# ── MLflow ───────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=smart-feedback-intelligence

# ── BERT ─────────────────────────────────────────────────
BERT_MODEL_NAME=bert-base-uncased
MAX_SEQ_LENGTH=128
BATCH_SIZE=16
EPOCHS=3
LEARNING_RATE=2e-5
